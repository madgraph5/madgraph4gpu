#
# This directory holds the googletest installation shared by all cudacpp process
# directories in epochX/cudacpp: the build of the cudacpp unit tests in each
# <proc>/SubProcesses/P*_* (target gtestlibs in cudacpp.mk) creates <proc>/test/GTEST
# as a symlink to ../../GTEST (this directory) and clones, builds and installs
# googletest here (in GTEST/googletest).
